{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PARMAR formal specialist approval record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "reviewer",
    "role",
    "scope",
    "artifact",
    "decision",
    "rationale",
    "evidence",
    "implementation_author_logins",
    "github_review",
    "timestamp",
    "conflicts",
    "conditions",
    "limitations",
    "status"
  ],
  "properties": {
    "record_id": { "type": "string", "pattern": "^[A-Z]+-[0-9]{4,}$" },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "github_login", "github_user_id", "verified_affiliation", "authority_id", "authority_basis", "verified_at"],
      "properties": {
        "identity": { "type": "string", "minLength": 3 },
        "github_login": { "type": "string", "pattern": "^[A-Za-z0-9-]+$" },
        "github_user_id": { "type": "integer", "minimum": 1 },
        "verified_affiliation": { "type": "string", "minLength": 3 },
        "authority_id": { "type": "string", "minLength": 3 },
        "authority_basis": { "type": "string", "minLength": 10 },
        "verified_at": { "type": "string", "format": "date-time" }
      }
    },
    "role": {
      "enum": [
        "Security",
        "Data Model",
        "Operations",
        "Privacy/Legal",
        "Provider Compatibility",
        "Release Authority"
      ]
    },
    "scope": { "type": "string", "minLength": 10 },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit_sha", "files"],
      "properties": {
        "commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        }
      }
    },
    "decision": { "enum": ["APPROVED", "REJECTED", "NEEDS_CHANGES"] },
    "rationale": { "type": "string", "minLength": 20 },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 3 }
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "implementation_author_logins": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9-]+$" }
    },
    "github_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "pull_request_number", "review_id", "commit_sha"],
      "properties": {
        "repository": { "const": "mksp1319-parmar/PARMAR-v1" },
        "pull_request_number": { "type": "integer", "minimum": 1 },
        "review_id": { "type": "integer", "minimum": 1 },
        "commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "conflicts": { "type": "array", "items": { "type": "string" } },
    "conditions": { "type": "array", "items": { "type": "string" } },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "status": { "enum": ["CURRENT", "SUPERSEDED", "REVOKED", "EXPIRED"] },
    "supersedes": { "type": "string", "pattern": "^[A-Z]+-[0-9]{4,}$" },
    "superseded_by": { "type": "string", "pattern": "^[A-Z]+-[0-9]{4,}$" },
    "expires_at": { "type": "string", "format": "date-time" },
    "revoked_at": { "type": "string", "format": "date-time" },
    "revocation_reason": { "type": "string", "minLength": 10 }
  }
}
