{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PARMAR specialist reviewer identity register",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "reviewers"],
  "properties": {
    "format": {
      "const": "parmar-specialist-reviewer-register-v1"
    },
    "reviewers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "github_login",
          "github_user_id",
          "verified_affiliation",
          "authority_id",
          "authority_basis",
          "verified_at",
          "roles"
        ],
        "properties": {
          "github_login": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]+$"
          },
          "github_user_id": {
            "type": "integer",
            "minimum": 1
          },
          "verified_affiliation": {
            "type": "string",
            "minLength": 3
          },
          "authority_id": {
            "type": "string",
            "minLength": 3
          },
          "authority_basis": {
            "type": "string",
            "minLength": 10
          },
          "verified_at": {
            "type": "string",
            "format": "date-time"
          },
          "roles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "Security",
                "Data Model",
                "Operations",
                "Privacy/Legal",
                "Provider Compatibility",
                "Release Authority"
              ]
            }
          }
        }
      }
    }
  }
}
