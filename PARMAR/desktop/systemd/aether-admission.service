[Unit]
Description=AETHER Linux admission IPC service
After=local-fs.target

# Template only: the backend fails closed until an independently managed
# anti-rollback anchor provider is available and configured.
[Service]
Type=simple
User=aether-admission
Group=aether-admission
EnvironmentFile=/etc/aether/admission-service.conf
RuntimeDirectory=aether-admission
RuntimeDirectoryMode=0750
StateDirectory=aether-admission
StateDirectoryMode=0700
UMask=0007
ExecStart=/usr/lib/aether/admission-service --socket /run/aether-admission/admission.sock --state-dir /var/lib/aether-admission --service-uid ${AETHER_SERVICE_UID} --access-gid ${AETHER_ACCESS_GID} --admission-uid ${AETHER_ADMISSION_UID} --browser-uid ${AETHER_BROWSER_UID} --lifecycle-uid ${AETHER_LIFECYCLE_UID} --observer-uid ${AETHER_OBSERVER_UID} --operator-uid ${AETHER_OPERATOR_UID} --node /usr/bin/node --worker /usr/lib/aether/admission-service-backend.cjs
Restart=no
KillMode=control-group
TimeoutStopSec=10s
SendSIGKILL=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
LimitNOFILE=128
TasksMax=32

[Install]
WantedBy=multi-user.target
