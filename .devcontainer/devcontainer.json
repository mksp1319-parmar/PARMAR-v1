{
  "name": "PARMAR Android 35",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "vscode",
  "containerEnv": {
    "JAVA_HOME": "/opt/java/temurin-17.0.21+9",
    "ANDROID_HOME": "/opt/android-sdk",
    "ANDROID_SDK_ROOT": "/opt/android-sdk"
  },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "PARMAR local interface",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "vscjava.vscode-java-pack"
      ]
    }
  }
}